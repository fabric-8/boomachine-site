# written by the deploy workflow from the ANALYTICS_TOKEN secret, never committed
analytics-config.php
# written by the deploy workflow from the NOTIFY_* secrets, never committed
notify-config.php
# scripts/notify-send.php's local run log
notify-send-*.log
# a.php runtime data (only .htaccess and index.html are tracked)
_data/*
!_data/.htaccess
!_data/index.html

# agent worktrees (Claude Code)
.claude/worktrees/
