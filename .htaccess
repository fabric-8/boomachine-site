# boomachine.app (ALL-INKL, Apache). Deployed from git by .github/workflows/deploy-allinkl.yml.

# PHP version. The account's top-level .htaccess (above /boomachine.app/, not
# ours) carries a legacy "AddHandler php53-cgi .php" that every domain folder
# inherits; PHP 5.3 no longer exists on the server, so .php answered "PHP
# version not supported" (ALL-INKL support, 2026-09-25). This pins the version
# chosen in KAS for this folder. Keep it in step with KAS.
AddHandler php85-cgi .php

# The same top-level .htaccess routes every missing path to its own index.php
# (a front controller for an app in the account root). Having any rewrite
# directive here stops that rule set from applying to this folder, so a
# missing page on boomachine.app is a plain 404 instead of a 500.
RewriteEngine On

# Analytics (a.php, stats.php) and the launch list (subscribe.php, notify-lib.php;
# README-NOTIFY.md): their data lives in _data/ and _data/notify/, which have
# their own "Require all denied". Belt and braces: data, lock, mail and config
# files and the list's code library are never served from anywhere, even if
# PHP or that file were missing.
<FilesMatch "(\.(jsonl|lock|eml)|^salt\.json.*|^analytics-config\.php|^notify-(config|lib)\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 403 ^/_data(/|$)

# stats.php reads "Authorization: Bearer ..."; PHP under FastCGI does not
# see that header unless it is copied into the environment.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
