# boomachine.app (ALL-INKL, Apache). Deployed from git by .github/workflows/deploy-allinkl.yml.

# PHP version. The account's top-level .htaccess (above /boomachine.app/, not
# ours) carries a legacy "AddHandler php53-cgi .php" that every domain folder
# inherits; PHP 5.3 no longer exists on the server, so .php answered "PHP
# version not supported" (ALL-INKL support, 2026-09-25). This pins the version
# chosen in KAS for this folder. Keep it in step with KAS.
AddHandler php85-cgi .php

# The same top-level .htaccess routes every missing path to its own index.php
# (a front controller for an app in the account root). Having any rewrite
# directive here stops that rule set from applying to this folder, so a
# missing page on boomachine.app is a plain 404 instead of a 500.
RewriteEngine On

# Canonical public URLs only. THE_REQUEST prevents DirectoryIndex's internal
# / -> /index.html lookup from redirecting the homepage back to itself.
# Keep existing query strings (campaigns) and URI escaping; localhost and
# historical draft/subdirectory index pages are deliberately unaffected.
RewriteCond %{HTTP_HOST} ^(?:www\.)?boomachine\.app(?::(?:80|443))?$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ https://boomachine.app/ [R=301,L,NE]

# Capture the original escaped path: REQUEST_URI can be decoded during
# per-directory rewriting (a%20b must not become a literal space).
RewriteCond %{HTTP_HOST} ^www\.boomachine\.app(?::(?:80|443))?$ [NC]
RewriteCond %{THE_REQUEST} \s(/[^?\s]*)
RewriteRule ^ https://boomachine.app%1 [R=301,L,NE]

# Analytics (a.php, stats.php) and the launch list (subscribe.php, notify-lib.php;
# README-NOTIFY.md): their data lives in _data/ and _data/notify/, which have
# their own "Require all denied". Belt and braces: data, lock, mail and config
# files and the list's code library are never served from anywhere, even if
# PHP or that file were missing.
<FilesMatch "(\.(jsonl|lock|eml)|^salt\.json.*|^analytics-config\.php|^notify-(config|lib)\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 403 ^/_data(/|$)

# stats.php reads "Authorization: Bearer ..."; PHP under FastCGI does not
# see that header unless it is copied into the environment.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>

# Short links for posts (Fab, 2026-11-02). Each forwards to its Apple campaign
# link, so App Store Connect still counts installs per channel (ct=...). 302,
# not 301, so a target can change later without browsers holding on to the old
# one. Full table: app repo, docs/marketing/halloween-2026/CAMPAIGN_LINKS.csv.
RedirectMatch 302 ^/li/?$ https://apps.apple.com/app/apple-store/id6812423821?pt=111946749&ct=linkedin&mt=8
RedirectMatch 302 ^/x/?$ https://apps.apple.com/app/apple-store/id6812423821?pt=111946749&ct=x&mt=8
# The general link for everything else (bio, slides, saying it out loud).
RedirectMatch 302 ^/get/?$ https://apps.apple.com/app/apple-store/id6812423821?pt=111946749&ct=get&mt=8
